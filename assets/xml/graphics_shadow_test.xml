<?xml version = "1.0" encoding = "UTF-8"?>
<map version = "1.0" name = "shadow shape test" parallel = "false">

    <direct package = "ru.framework2d.graphics.render" engineName = "OutputRenderHQ"
        quality = "high" shadowBufferScale = "1.0" shadowSharp = "true" shadows = "true">

        <handler engineName = "HandlerRenderHQ">
            <sub subpackage = "camera" engineName = "CameraRenderSystem"/>
            <sub subpackage = "light" engineName = "LightRenderSystem"/>
            <sub subpackage = "sprite" engineName = "SpriteRenderSystem"/>
            <sub subpackage = "relief" engineName = "ReliefRenderSystem"/>
            <sub subpackage = "shadow" engineName = "ShadowRenderSystem"/>
            <sub subpackage = "text" engineName = "TextRenderSystem"/>
        </handler>

        <handler package = "ru.framework2d.graphics.cameras" engineName = "HandlerCameras"/>
    </direct>

    <replace name = "width" value = "DisplayWidth"/>
    <replace name = "height" value = "DisplayHeight"/>

    <entity name = "background" single = "true">
        <pict spriteName = "board" layer = "-1"
            position:x = "0" position:y = "0"
            size:x = "160" size:y = "160"/>
    </entity>

    <entity name = "basecam" single = "true">
        <camera
            name = "basecam"
            position:x = "width/2" position:y = "height/2"
            eyePos:x = "0" eyePos:y = "0"
            zoom = "width/100.0"/>
    </entity>

    <!-- light marker + point light on the same XY,
         left/above the caster band so every shadow stretches right/down -->
    <entity name = "light" single = "true">
        <pict spriteName = "valid_checker" layer = "3"
            position:x = "-100/3" position:y = "-100/3" position:z = "100/16"
            size:x = "25/24" size:y = "25/24"
            isCircle = "true" radius = "100/48"/>

        <light
            position:x = "-100/3" position:y = "-100/3" position:z = "100/2"
            radius = "1000" color = "#FFFFFF" intensity = "0.9" diffuse = "0.3"
            ambient = "0.45" castsShadows = "true"/>
    </entity>

    <!-- caster 1: short thin cylinder -->
    <entity name = "caster_cyl_r4_h2" single = "true">
        <pict radius = "4" spriteName = "bonehead" layer = "2"
            position:x = "-30" position:y = "0"/>
        <shadow
            position:x = "-30" position:y = "0" position:z = "0"
            layer = "1.9" opacity = "0.6" softness = "0.0"
            geometry:type = "v_cylinder" geometry:radius = "4" geometry:height = "2"/>
        <text
            position:x = "-30" position:y = "10"
            size:x = "40" size:y = "10" layer = "5"
            text = "CYL R4 H2" color = "#FFFFFF" fontSize = "3"/>
    </entity>

    <!-- caster 2: same radius, taller -> longer shadow -->
    <entity name = "caster_cyl_r4_h8" single = "true">
        <pict radius = "4" spriteName = "bonehead" layer = "2"
            position:x = "-10" position:y = "0"/>
        <shadow
            position:x = "-10" position:y = "0" position:z = "0"
            layer = "1.9" opacity = "0.6" softness = "0.0"
            geometry:type = "v_cylinder" geometry:radius = "4" geometry:height = "8"/>
        <text
            position:x = "-10" position:y = "10"
            size:x = "40" size:y = "10" layer = "5"
            text = "CYL R4 H8" color = "#FFFFFF" fontSize = "3"/>
    </entity>

    <!-- caster 3: wider cylinder -->
    <entity name = "caster_cyl_r6_h4" single = "true">
        <pict radius = "4" spriteName = "bonehead" layer = "2"
            position:x = "10" position:y = "0"/>
        <shadow
            position:x = "10" position:y = "0" position:z = "0"
            layer = "1.9" opacity = "0.6" softness = "0.0"
            geometry:type = "v_cylinder" geometry:radius = "6" geometry:height = "4"/>
        <text
            position:x = "10" position:y = "10"
            size:x = "40" size:y = "10" layer = "5"
            text = "CYL R6 H4" color = "#FFFFFF" fontSize = "3"/>
    </entity>

    <!-- caster 4: box geometry -->
    <entity name = "caster_block_w8_d4_h6" single = "true">
        <pict radius = "4" spriteName = "bonehead" layer = "2"
            position:x = "30" position:y = "0"/>
        <shadow
            position:x = "30" position:y = "0" position:z = "0"
            layer = "1.9" opacity = "0.6" softness = "0.0"
            geometry:type = "block" geometry:width = "8" geometry:depth = "4" geometry:height = "6"/>
        <text
            position:x = "30" position:y = "10"
            size:x = "40" size:y = "10" layer = "5"
            text = "BLOCK W8 D4 H6" color = "#FFFFFF" fontSize = "3"/>
    </entity>

</map>
